
pipeline {
    agent any

    stages {
        stage('Build') {
            steps {
                dir('Exercise_9') {
                    echo 'Installing Python dependencies...'
                    sh '''
                        python3 -m venv .venv
                        .venv/bin/python -m pip install --upgrade pip
                        .venv/bin/pip install -r requirements.txt
                    '''
                }
            }
        }

        stage('Test') {
            steps {
                dir('Exercise_9') {
                    echo 'Running unit tests...'
                    sh '.venv/bin/python -m unittest discover -s . -p "test_*.py"'
                }
            }
        }

        stage('Deploy') {
            steps {
                dir('Exercise_9') {
                    echo 'Copying application to deployment directory...'
                    sh '''
                        mkdir -p "$WORKSPACE/python-app-deploy"
                        cp app.py "$WORKSPACE/python-app-deploy/"
                    '''
                }
            }
        }

        stage('Run Application') {
            steps {
                dir('Exercise_9') {
                    echo 'Starting Flask application...'
                    sh '''
                        nohup "$WORKSPACE/Exercise_9/.venv/bin/python" \
                          "$WORKSPACE/python-app-deploy/app.py" \
                          > "$WORKSPACE/python-app-deploy/app.log" 2>&1 &
                        echo $! > "$WORKSPACE/python-app-deploy/app.pid"
                    '''
                }
            }
        }

        stage('Test Application') {
            steps {
                echo 'Checking application HTTP response...'
                sh '''
                    for i in $(seq 1 15); do
                        if curl -fsS http://127.0.0.1:5000/ \
                          > "$WORKSPACE/python-app-deploy/response.txt"; then
                            break
                        fi
                        sleep 1
                    done

                    grep -Fx \
                      'Hello, Jenkins Multi-Stage Pipeline!' \
                      "$WORKSPACE/python-app-deploy/response.txt"
                '''
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully!'
        }
        failure {
            echo 'Pipeline failed. Check Console Output.'
        }
    }
}
