
#include <tunables/global>

profile my-apparmor-profile flags=(attach_disconnected) {
    #include <abstractions/base>

    # Allow network connections needed by the Flask application
    network inet stream,

    # Allow access to the application directory
    /app/** rw,

    # Deny reading protected configuration and account files
    deny /etc/passwd r,
    deny /etc/shadow r,

    # Deny write access to system directories
    deny /var/** w,

    # Restrict administrative capability
    deny capability sys_admin,
}
