
pipeline {
    agent any

    stages {
        stage('Verify Project Files') {
            steps {
                sh 'test -f Exercise_6/delivery_monitoring/delivery_metrics.py'
                sh 'test -f Exercise_6/delivery_monitoring/prometheus.yml'
                sh 'test -f Exercise_6/delivery_monitoring/alert_rules.yml'
                sh 'test -f Exercise_6/delivery_monitoring/requirements.txt'
                sh 'test -f Exercise_6/delivery_monitoring/Dockerfile'
                sh 'echo "All delivery monitoring files are present."'
            }
        }
    }

    post {
        success {
            echo 'Delivery monitoring CI checks passed!'
        }
        failure {
            echo 'Pipeline failed. Check the console output.'
        }
    }
}
